{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{server/**,public/brand/casa-verde.png,node_modules/pdfkit/js/data/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?route=:path*"
    },
    {
      "source": "/logout",
      "destination": "/api?route=auth/logout"
    }
  ]
}
