# Sem estas variáveis, npm start usa SQLite e arquivos locais em .data.
# Produção Vercel: configure TODAS estas variáveis no painel, nunca no GitHub.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=
STORE_SCHEMA=cv_casaverde
PORT=5173

# Opcional, usado somente pelo verificador de produção após uma implantação real:
PRODUCTION_URL=
# PostgreSQL hospedado usa TLS por padrão. Não configure DATABASE_SSL=false em produção.
